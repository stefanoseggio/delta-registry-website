                        },
                        "patentOwnerRealPartyInInterestName": {
                          "title": "Patent Owner Real Party in Interest",
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "uspto_ptab only"
                        },
                        "petitionerRealPartyInInterestName": {
                          "title": "Petitioner Real Party in Interest",
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "uspto_ptab only"
                        },
                        "petitionerCounselName": {
                          "title": "Petitioner Counsel",
                          "type": [
                            "string",
                            "null"
                          ],
                          "description": "uspto_ptab only"
                        },
                        "inventorName": {
